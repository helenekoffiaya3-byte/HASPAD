# HASPAD Northflank Runtime Adapter
PORT=3001
RUNTIME_SHARED_SECRET=replace-with-a-strong-secret

NORTHFLANK_API_TOKEN=replace-with-northflank-api-token
NORTHFLANK_PROJECT_ID=replace-with-northflank-project-id

# Use the plans available in your Northflank account.
NORTHFLANK_DEPLOYMENT_PLAN=nf-compute-10
NORTHFLANK_BUILD_PLAN=nf-compute-200-8

# Optional linked GitHub account in Northflank.
# Needed for private repositories unless Northflank can select another linked account.
NORTHFLANK_GITHUB_ACCOUNT_LOGIN=

# Enable only after the custom domain is configured in Northflank/DNS.
NORTHFLANK_USE_CUSTOM_DOMAINS=false
