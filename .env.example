NODE_ENV=development
PORT=5000

# 1. URL publique/interne du backend OAuth et API
BACKEND_URL=http://localhost:5000

# 2. URL du frontend utilisée après authentification
FRONTEND_URL=http://localhost:3000

# 3. Connexion PostgreSQL / Supabase — serveur uniquement
# Remplacer par la chaîne fournie par Supabase > Connect
DATABASE_URL=

# 4. Secret JWT — générer une valeur aléatoire longue, jamais dans GitHub
JWT_SECRET=

# Supabase — compatibilité avec l'ancienne configuration
SUPABASE_DB_URL=

# ResellersPanel — serveur uniquement
RESELLERS_API_URL=https://api.duoservers.com
RESELLERS_API_USER=magasin246953
RESELLERS_API_PASSWORD=
RESELLERS_HOSTING_PLAN=cloud_starter
HASPАD_HOSTING_DOMAIN=haspad.com

# OAuth multi-fournisseurs — serveur uniquement
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
BITBUCKET_CLIENT_ID=
BITBUCKET_CLIENT_SECRET=

# JWT refresh — réservé aux évolutions utilisant un refresh token séparé
JWT_REFRESH_SECRET=
