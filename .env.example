NODE_ENV=production
PORT=3000
PUBLIC_SITE_URL=https://haspad.com
PUBLIC_API_URL=https://haspad.com/api
FRONTEND_URL=https://haspad.com
BACKEND_URL=https://haspad.com

# AI — server only
OPENAI_API_KEY=
CHATGPT_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-pro-preview

# GitHub OAuth — server only
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=https://haspad.com/.netlify/functions/github-callback
GITHUB_OAUTH_STATE_SECRET=
GITHUB_TOKEN_ENCRYPTION_KEY=
GITHUB_API_VERSION=2022-11-28

# Deployment billing — server only
GIT_DEPLOY_CREDIT_COST=300
NETLIFY_AUTH_TOKEN=

# PayDunya — server only
PAYDUNYA_MODE=sandbox
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_TOKEN=
PAYDUNYA_CALLBACK_URL=https://haspad.com/api/paydunya-callback
PAYDUNYA_STARTUP_AMOUNT_XOF=
PAYDUNYA_PRO_AMOUNT_XOF=
PAYDUNYA_BUSINESS_AMOUNT_XOF=

# Northflank Docker runtime — server only
NORTHFLANK_API_URL=https://api.northflank.com/v1
NORTHFLANK_API_TOKEN=
NORTHFLANK_PROJECT_ID=
NORTHFLANK_DEPLOYMENT_PLAN=
NORTHFLANK_BUILD_PLAN=
NORTHFLANK_GITHUB_ACCOUNT_LOGIN=

# Domain / registrar — server only
HASPAD_HOSTING_DOMAIN=haspad.com
RESSELLERS_API_URL=
RESSELLERS_API_USER=
RESSELLERS_API_PASSWORD=
RESSELLERS_HOSTING_PLAN=
LETSENCRYPT_EMAIL=
